{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Accoding: Test",
      "type": "process",
      "command": "accoding",
      "args": [
        "test",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Accoding: Submit",
      "type": "process",
      "command": "accoding",
      "args": [
        "submit",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
